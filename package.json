{
  "name": "gs-mcp",
  "version": "0.1.0",
  "description": "Global Shopaholics MCP server: US shipping rates, landed-cost estimates, assisted purchase and shipment requests for AI agents.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/entry/node.js",
  "bin": {
    "gs-mcp-stdio": "dist/entry/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/entry/node.js",
    "dev": "tsx src/entry/node.ts",
    "stdio": "tsx src/entry/stdio.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}

{
  "name": "gs-mcp",
  "version": "1.0.0",
  "description": "Global Shopaholics MCP server: US shipping rates, landed-cost estimates, assisted purchase and shipment requests for AI agents.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/entry/node.js",
  "bin": {
    "gs-mcp-stdio": "dist/entry/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/entry/node.js",
    "dev": "tsx src/entry/node.ts",
    "stdio": "tsx src/entry/stdio.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "mcpb:build": "esbuild mcpb/src/proxy.ts --bundle --platform=node --format=esm --target=node18 --outfile=mcpb/server/index.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && cd mcpb && npx -y @anthropic-ai/mcpb pack . global-shopaholics.mcpb",
    "site-files": "tsx scripts/gen-site-files.ts",
    "openai:zip": "python3 -c \"import shutil;shutil.make_archive('plugins/openai/global-shopaholics-openai-plugin','zip','plugins/openai/global-shopaholics')\"",
    "duty:freshness": "tsx scripts/duty-freshness.ts",
    "duty:wits": "tsx scripts/fetch-wits.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}

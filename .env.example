# ---- Rates engine (GS WordPress plugin) ----
GS_RATES_URL=https://globalshopaholics.com/wp-json/rate-calculator/v2/getrates
GS_RATES_REFERER=https://globalshopaholics.com/international-shipping-calculator/
# Optional shared-secret header GS's developer can whitelist in Imunify360 / Cloudflare WAF, e.g. X-GS-MCP-Key
GS_RATES_HEADER_NAME=
GS_RATES_HEADER_VALUE=
GS_RATES_TIMEOUT_MS=25000
# Honest, identifiable User-Agent (whitelist this string if needed)
GS_USER_AGENT=GlobalShopaholics-MCP/0.1 (+https://globalshopaholics.com)

# ---- Lead sinks (all optional; with none set, tools return GS's own request pages) ----
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE=https://services.leadconnectorhq.com
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
LEAD_RATE_LIMIT_PER_HOUR=5
LEAD_EMAIL_LIMIT_PER_DAY=3
LEAD_DAILY_CAP=200
RATE_LIMIT_PER_HOUR=30

# ---- Duties (optional) ----
EASYSHIP_API_KEY=
EASYSHIP_TAX_URL=https://public-api.easyship.com/2024-09/taxes_and_duties

# ---- Assisted purchase fee policy ----
GS_ASSISTED_FEE_PCT=5
GS_ASSISTED_FEE_MIN_USD=5
GS_ASSISTED_FEE_WAIVED_METHODS=bank_transfer,crypto

# ---- Crypto checkout (BTCPay Server; key needs only create+view invoices) ----
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
CRYPTO_MAX_USD=10000

# ---- Price search (Serper Google Shopping) ----
SERPER_API_KEY=
PRICE_SEARCH_PER_HOUR=10

# ---- HTTP ----
PORT=8787
ALLOWED_ORIGINS=*
PUBLIC_BASE_URL=
